# Local credentials; keep the shareable configuration template.
.env
.env.*
!.env.example

# Local Python environments and generated bytecode.
.venv/
venv/
__pycache__/
*.py[cod]

# Test, coverage, and static-analysis artifacts.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Python packaging output.
build/
dist/
*.egg-info/

# Runtime databases, cache, logs, reports, and staged runs.
data/*
!data/.gitkeep

# macOS metadata, including when this folder is used independently.
.DS_Store
._*
.AppleDouble/
