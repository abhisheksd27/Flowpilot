# builtin runs the real pipeline with deterministic rules and needs no LLM key.
LLM_PROVIDER=builtin
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
DATA_DIR=./data
API_CACHE_TTL=900
LLM_CACHE_TTL=86400
HTTP_TIMEOUT=20
BACKOFF_SECONDS=1
MAX_RETRIES=3
PYTHON_TIMEOUT=30
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=agent-de-sandbox:local
SCHEDULE_FREQUENCY=hourly
# Used only for daily frequency:
SCHEDULE_TIME=08:00
SCHEDULE_TIMEZONE=Asia/Kolkata
